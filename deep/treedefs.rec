
%dir deep
%namespace deep 

%define yanf ( tab_empty ) 

%prefix labelset : 
   std::unordered_set< calc::label, 
                       calc::label::hash, calc::label::equal_to > 

%option empty { tab_empty } => 
%option label { yanf_fe, yanf_t, yanf_ft, yanf_e } => fm : logic::term 
%option prop { yanf_disj, yanf_conj } => fm : logic::term 
%option quant { yanf_forall, yanf_exists } => body : logic::term, 
                                              [ var: logic::vartype ]  
%option delta { yanf_let } => 
                  var : logic::vartype, val : logic::term, body : logic::term


%h_incl {
   #include "tvm/concepts.h"
   #include "tvm/includes.h"
   #include <unordered_set>
   #include "logic/term.h"
   #include "calc/label.h"
}

%h_before {
   bool very_equal( const std::vector< logic::vartype > & v1, 
                    const std::vector< logic::vartype > & v2 );
}


