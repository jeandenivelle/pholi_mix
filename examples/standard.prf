
%seqcalc fromto_prop{ Prop( Obj ), Prop( Obj ) } :
{
   %show "kut";
   %branch #-1, #0, { } :
   {
      %expand #-1, goal, #0;
      %expand #-1, strict, #0;
      %expand #-1, strict, #0;
      %normalize #-1;
      %flatten #-1;
   }
 
   %branch #-1, #0, { } :
   {
      %expand #-1, goal, #0;
      %expand #-1, strict, #0;
      %expand #-1, strict, #0;
      %expand #-1, fromto, #0;
      %normalize #-1;
      %flatten #-1;
      %branch #-1, #0, { "P", "Q" } :
      {
         %flatten #-1;
         %setname #-3, f1;
         %setname #-2, f2;
         %flatten #-1;
         %branch #-1, #0, { "f", "x" } :
         {
            %instantiate $f1, { x };
            %simplify; 
         } 

         %branch #-1, #0, { "f", "x" } :
         {
            %instantiate $f2, { f(x) };
            %simplify;
         }
      } 
   }
}


