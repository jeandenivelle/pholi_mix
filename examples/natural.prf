
%seqcalc
isclosed_prop{ Nat, Prop( Obj ) } :
{
   %setname #-1, cutform;
   %branch $cutform, #0, { } :
   {
      %expand #-1, goal, #0;
      %flatten #-1;
      %branch #-1, #0, {} :
      {
         %expand #-1, strict, #0;
         %normalize #-1;
         %flatten #-1;
      } 
   } 
   %branch #-1, #0, { } :
   {
      %expand #-1, goal, #0;
      %flatten #-1;
      %branch #-1, #0, { "s", "P" } :
      {
         %flatten #-1;
         %expand #-1, isclosed, #0;
         %normalize #-1;
         %flatten #-1;
         %import fromto_prop;
         %flatten #-1;
         %setname #-1, prop;
         %instantiate $prop, { P, P };
         %flatten #-1;
         %simplify;
         %flatten #-1;
         %instantiate #-1, { s. succ };
      }
   }
}
   
%seqcalc
gen_prop{ Nat } :
{
   %cut goal;
   %setname #-1, cutform; 
   %branch $cutform, #0, { };
   %expand #-1, goal, #0;
   %flatten #-1; 
   %branch #-1, #0, {};
   %expand #-1, strict, #0;
   %normalize #-1;
   %flatten #-1;
   %merge; 
   %merge; 
   
   %branch #-1, #0, { };
   %expand #-1, goal, #0;
   %flatten #-1;
   %branch #-1, #0, { };
   %expand #-1, strict, #0;
   %normalize #-1;
   %flatten #-1;
   %branch #-1, #0, { "x" }; 
   %flatten #-1;
   %expand #-1, gen, #0; 
   %expand #-1, minimal, #0;
   %normalize #-1;
   %flatten #-1;
   %show "unfinished"; 
}

