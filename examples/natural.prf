
%seqcalc
isclosed_prop{ Nat, Prop( Obj ) } :
{
   %branch #0 #0 { } :
   {
      %expand #-1 goal #0;
      %flatten #-1;
      %branch #-1 #0 { } :
      {
         %expand #-1 strict #0;
         %normalize #-1;
         %flatten #-1;
      } 
   } 
   %branch #-1 #0 { } :
   {
      %expand #-1 goal #0;
      %flatten #-1;
      %branch #-1 #0 { "s", "P" } :
      {
         %flatten #-1;
         %expand #-1 isclosed #0;
         %setname #-2 strictP;
         %normalize #-1;
         %flatten #-1;
         %import fromto_prop { Prop( Obj ), Prop( Obj ) };
         %setname #-1 fromtoprop;
         %flatten #-1;
         %setname #-1 prop;
         %instantiate $prop { P, P };
         %flatten #-1;
         %simplify;
         %flatten #-1;
         %instantiate #-1 { s. succ };
         %simplify;
         // This should become %import fromto_prop( Prop( Obj ), Obj ),
         // now we just write out the proof:
         %expand #-1 fromto #0;
         %normalize #-1;
         %expand $strictP strict #0;
         %normalize #-1; 
         %flatten #-1;
         %instantiate #-1 { s.0 };
         %simplify;
      }
   }
}

%seqcalc gen_prop{ Nat } :
{
   %branch #0 #0 { }:
   {
      %expand #-1 goal #0;
      %expand #-1 strict #0;
      %normalize #-1;
      %flatten #-1;
   }
   %expand #-1 goal #0;
   %expand #-1 strict #0;
   %expand #-1 gen #0; 
   // We could use a theorem here, or just write it out:
   %expand #-1 minimal #0;
   %normalize #-1;
   %flatten #-1; 
   %branch #-1 #0 { }:
   {
      %expand #-1 stricton #0;
      %normalize #-1;
      %flatten #-1;
      %branch #0 #0 { }:
      {
         %expand #-1 univ1 #0;
         %normalize #-1;
         %flatten #-1;
      }
   }
   %branch #-1 #0 { }:
   {
      %flatten #-1;
      %setname #-2 stricton;
      %flatten #-1;
      %import isclosed_prop { Nat, Prop( Obj ) };
      %flatten #-1;
      %instantiate #-1 { n, R }; 
      %hide #-2;
      %flatten #-1;
      %expand #-1 strict #0;
      %normalize #-1;
      %flatten #-1;
      %branch #-1 #1 { }:
      {
         %simplify;
         %expand $stricton stricton #0;
         %expand #-1 univ1 #0;
         %normalize #-1;
         %flatten #-1;
         %instantiate #-1 { x1 };
         %flatten #-1;
         %simplify;
      }
      %branch #-1 #0 { "x1b" }:
      {
         %flatten #-1;
         %expand $stricton stricton #0;
         %expand #-1 univ1 #0;
         %normalize #-1;
         %flatten #-1;
         %instantiate #-1 { x1b }; 
         %flatten #-1;
         %simplify;
      }
   }
}

%seqcalc justification { Nat, Nat, Obj, Obj }:
{
   %branch #0 #0 { } :
   {
      // The type checking proof.

      %fake false;
      %flatten #-1;
   }

   %expand #-1 goal #0; 
   %flatten #-1;

   %branch #-1 #0 { "s1", "s2", "x1", "x2" } :
   {
         %flatten #-1; 
         %expand #-3 minhomrel #0;
         %expand #-1 minimal #0; 
         %normalize #-1;
         %flatten #-1;
         %setname #-1 mainforall; 
         %let Q := lambda{ n1, n2 : Nat } :
                         lambda{ x1, x2 : Obj } :
                            ( x1 == n1.0 & x2 == n2.0 ) | 
                            exists{ y1, y2 : Obj } :
                               < n1. gen(y1) & n2. gen(y2) > 
                                  minhomrel( n1, n2, y1, y2 ) &
                                  x1 == n1. succ(y1) &
                                  x2 == n2. succ(y2) : 
         {
            %instantiate $mainforall { Q(s1,s2) };
            %flatten #-1;
            %branch #-1 #1 { } :
            {
               %expand #-1 homrel #0;
               %normalize #-1;
               %flatten #-1;
               %branch #-1 #0 { } :
               { 
                  %expand #-1 Q #0; 
                  %normalize #-1;
                  %flatten #-1;
                  %flatten #-2;
                  %simplify;
               }
               %show "indef";
            } 
            // We are at label "induction";
            // %instantiate #-1 { Q(s1,s2) }; 
         }
   }
}

