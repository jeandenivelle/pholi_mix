
// It's nice that I can prove this but it is TOO LONG!

%seqcalc
strict_prop{ Order } :
{
   %branch #0 #0 { } :
   {
      %expand #-1 goal #0;
      %flatten #-1;
   }
   %expand #-1 goal #0;
   %flatten #-1;

   %branch #-1 #0 { "ord" } :
   {
      %expand #-1 strict #0;
      %normalize #-1;
      %flatten #-1;
      %branch #-1 #0 { } :
      {
         %expand #-1 strict #0;
         %normalize #-1;
         %flatten #-1;
      }
      %flatten #-1;
      %givename #-2 strict;
      %expand #-1 stricton #0; 
      %normalize #-1;
      %flatten #-1;
      %branch #-1 #0 { "x1", "x2" } :
      {
         %expand #-1 prod #0;
         %normalize #-1;
         %flatten #-1;
         %expand $strict strict #0;
         %normalize #-1;
         %flatten #-1;
         
         %instantiate #-1 { x1 };
         %instantiate #-2 { x2 };
         %simplify; 
      }
   }
}

%seqcalc
trans_prop{ Order } :
{
   %branch #0 #0 { } :
   {
      %expand #-1 goal #0;
      %show "inside";
      %flatten #-1;
   }
   %show "restart";
   %expand #-1 goal #0;
   %flatten #-1;
   %branch #0 #0 { "ord" } :
   {
      %expand #-1 trans #0;
      %normalize #-1;
      %flatten #-1;
      %branch #-1 #0 { "d1", "d2", "d3" } :
      {
         %import strict_prop{ Order };
         %flatten #-1;
         %instantiate #-1 { ord };
         %expand #-1 strict #0; 
         %flatten #-1;
         %normalize #-1;
         %flatten #-1;
         %expand #-2 strict #0;
         %normalize #-1;
         %flatten #-1;
         %show "before"; 
      }
   }
}

